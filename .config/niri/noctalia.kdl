layout {

    focus-ring {
        active-color   "#22c3bd"
        inactive-color "#e3e8e8"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#22c3bd"
        inactive-color "#e3e8e8"
        urgent-color   "#fd4663"
    }

    shadow {
        color "#c4d4d370"
    }

    tab-indicator {
        active-color   "#22c3bd"
        inactive-color "#b2e6e4"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#22c3bd80"
    }
}

recent-windows {
    highlight {
        active-color "#22c3bd"
        urgent-color "#fd4663"
    }
}
